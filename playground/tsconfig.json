{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "paths": {
      "@codex-proxy/ui": ["../src/index.ts"],
      "@codex-proxy/ui/theme": ["../src/theme/index.ts"],
      "@codex-proxy/ui/*": ["../src/components/*/index.ts"]
    }
  },
  "include": ["../env.d.ts", "**/*.ts", "**/*.vue", "**/*.md", ".vitepress/**/*.ts", ".vitepress/**/*.vue"],
  "exclude": [".vitepress/cache", ".vitepress/dist"],
  "vueCompilerOptions": { "vitePressExtensions": [".md"] }
}
